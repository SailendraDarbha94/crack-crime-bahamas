{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "police": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.val() === true"
      }
    },

    "wanteds": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        "archived": { ".validate": false },
        "archiveLog": { ".validate": false }
      }
    },
    "missings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        "archived": { ".validate": false },
        "archiveLog": { ".validate": false }
      }
    },

    "archive": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "wanteds": {
        "$id": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name', 'archived'])",
          "archived": {
            ".validate": "newData.hasChildren(['at', 'by', 'remarks']) && newData.child('by').val() === auth.uid",
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "remarks": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12000" },
            "$other": { ".validate": false }
          }
        }
      },
      "missings": {
        "$id": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name', 'archived'])",
          "archived": {
            ".validate": "newData.hasChildren(['at', 'by', 'remarks']) && newData.child('by').val() === auth.uid",
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "remarks": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "adverts": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "heroes": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$messageId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['message', 'created_at'])",
        "message": {
          ".validate": "(newData.isString() && newData.val().length > 0 && newData.val().length <= 10000) || newData.hasChildren()"
        },
        "created_at": {
          ".validate": "newData.isNumber() || newData.isString()"
        },
        "pin": {
          ".validate": "newData.isString() && newData.val().matches(/^[2-9A-HJKMNP-Z]{6}$/)"
        },
        "archive": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.hasChildren(['at', 'by', 'remarks']) && newData.child('by').val() === auth.uid",
          "at": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "remarks": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12000" },
          "$other": { ".validate": false }
        },
        "archiveLog": {
          ".validate": "newData.hasChildren()",
          "$entryId": {
            ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['action', 'at', 'by'])",
            "action": { ".validate": "newData.val() === 'archived' || newData.val() === 'restored'" },
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "remarks": { ".validate": "newData.isString() && newData.val().length <= 12000" },
            "$other": { ".validate": false }
          }
        },
        "followUps": {
          "$followUpId": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['message', 'created_at'])",
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10000"
            },
            "created_at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 300000"
            },
            "encrypted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },

    "policeTips": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('police').child(auth.uid).val() === true)",
      "$tipId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['message', 'created_at', 'forwarded_at', 'forwarded_by'])",
        "pin": {
          ".validate": "newData.isString() && newData.val().matches(/^[2-9A-HJKMNP-Z]{6}$/)"
        },
        "message": {
          ".validate": "(newData.isString() && newData.val().length > 0 && newData.val().length <= 10000) || newData.hasChildren()"
        },
        "encrypted": {
          ".validate": "newData.isBoolean()"
        },
        "created_at": {
          ".validate": "newData.isNumber() || newData.isString()"
        },
        "forwarded_at": {
          ".validate": "newData.isNumber()"
        },
        "forwarded_by": {
          ".validate": "newData.val() === auth.uid"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 12000"
        },
        "followUps": {
          "$followUpId": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists()",
            ".validate": "newData.hasChildren(['message', 'created_at'])",
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10000"
            },
            "created_at": {
              ".validate": "newData.isNumber()"
            },
            "encrypted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "tipPins": {
      "$pin": {
        ".read": true,
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$pin.matches(/^[2-9A-HJKMNP-Z]{6}$/) && newData.hasChildren(['tipId', 'created_at'])",
        "tipId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "created_at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "notifications_register": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$token": {
        ".read": true,
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren()"
      }
    },
    "registrations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$token": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren()"
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['firstName', 'lastName', 'email', 'created_at'])"
      }
    },

    "notifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
