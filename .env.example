# Firebase web config (safe to expose — protected by Firebase security rules)
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_DATABASE_URL=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_MEASUREMENT_ID=

# ── Server-only secrets (NO NEXT_PUBLIC_ prefix — never bundled client-side) ──

# Expo push notifications access token (expo.dev account settings)
EXPO_ACCESS_TOKEN=

# Google Maps Geocoding API key (used server-side by /api/notification/geocode)
GOOGLE_MAPS_API_KEY=

# Invite code required by the /sign-up page (share only with trusted people;
# real admin authority still requires an /admins allowlist entry)
INVITE_CODE=

# AES key for encrypting anonymous tips at rest. MUST match the key compiled
# into the mobile app until a coordinated key rotation.
TIP_ENCRYPTION_KEY=
