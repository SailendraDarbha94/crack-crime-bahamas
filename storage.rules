rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage rules cannot read the Realtime Database, so admin identity is
    // pinned by uid here. BEFORE DEPLOYING: replace the placeholder below
    // with the real admin uid(s) from Firebase Console -> Authentication.
    // Keep this list in sync with the /admins node in the database.
    function isAdmin() {
      return request.auth != null &&
             request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    // request.resource == null keeps admin DELETES legal (no resource on delete).
    // Size/type limits mirror the client-side validation (5MB, images only).
    function isValidImage() {
      return request.resource == null ||
             (request.resource.size < 5 * 1024 * 1024 &&
              request.resource.contentType.matches('image/.*'));
    }

    // Public content rendered by the website and the mobile app
    match /adverts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    // Hub-screen hero images (heroes/<screen>/hero.png) — read by the app,
    // managed from the website admin
    match /heroes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /missings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /wanteds/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Legacy paths — nothing in the web app writes these today
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
